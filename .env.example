# Copy to .env.local and fill in
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
NOMINATIM_API_URL=https://nominatim.openstreetmap.org/search
# Google Places API (New) — the only discovery source that returns a business's
# own `website` field. Every free web-search route is bot-blocked (DDG 403,
# Brave 429, Mojeek/Startpage JS-only), so without this key website discovery
# finds nothing. Enable "Places API (New)" on a billing-enabled project.
# Estimated ~$5 per 1000 Text Search requests after the monthly credit.
GOOGLE_PLACES_API_KEY=
# Comma-separated lead categories the discovery pipeline targets.
# Supported: School, Restaurant, Cafe, Gym / Fitness, Salon / Beauty
DISCOVERY_CATEGORIES=School,Restaurant,Cafe,Gym / Fitness,Salon / Beauty
MOCK_MODE=false
AGENT_CONCURRENCY=2
OUTREACH_REQUIRE_APPROVAL=true

# --- Automated approval ---
# The Verifier agent checks each draft before anything is sent: the address must
# sit on a domain proven to belong to that business, the receiving mail server
# must confirm the mailbox exists (SMTP RCPT probe), and the body must quote the
# correct offer. All checks passing auto-approves the draft and the sender
# delivers it. Set to false for manual approval instead.
AUTO_APPROVE=true

# --- Autonomous engine (optional; sensible defaults if omitted) ---
# Master switch for the self-running background engine.
AUTONOMOUS_MODE=true
# How often the engine launches a brand-new lead-finding mission (ms).
AUTO_MISSION_INTERVAL_MS=120000
# How often the engine advances the pipeline queues (ms).
PIPELINE_INTERVAL_MS=10000
# When a lead's outreach is "sent", the engine can fabricate a realistic reply
# so the whole pipeline (reply -> book -> proposal -> done) completes on its own.
SIMULATE_REPLIES=true
# Delay before a fabricated reply shows up for a sent lead (ms).
REPLY_DELAY_MS=45000
# Comma-separated cities the autonomous launcher cycles through.
AUTO_CITIES=Patna,Delhi,Mumbai,Bengaluru,Kolkata,Pune,Hyderabad,Chennai,Jaipur,Ahmedabad

# --- Inbox monitoring (IMAP, same Gmail app password) ---
MAIL_ENABLED=true
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USER=you@gmail.com
MAIL_PASS=
MAIL_POLL_INTERVAL_MS=120000

# ---- Real email sending (Gmail app-password, fully free) ----
# SMTP_PASS = 16-char Gmail App Password (https://myaccount.google.com/apppasswords)
# Test connection: POST /api/smtp/test
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME="Your Name"
SENDER_NAME="Your Name"
SENDER_ROLE="a local developer building affordable digital solutions for small businesses"
